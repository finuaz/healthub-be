# Supabase hosted Postgres connection string (session pooler)
# Format: postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URI=postgresql://postgres.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_URLENCODED_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase project identifiers (no secrets)
SUPABASE_PROJECT_REF=REPLACE_WITH_PROJECT_REF
SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co